{
  "name": "form-and-field-mern",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "node --watch server.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server.js",
    "seed": "node server/seed.js",
    "test": "node --test server/tests/*.test.js",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mongoose": "^8.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "mongodb-memory-server": "^10.2.0"
  }
}
