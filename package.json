{
  "name": "form-and-field-mern",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node --watch server.js",
    "client": "node node_modules/vite/bin/vite.js --config client/vite.config.js",
    "dev:client": "node node_modules/vite/bin/vite.js --config client/vite.config.js",
    "dev:server": "node --watch server.js",
    "build": "node node_modules/vite/bin/vite.js build --config client/vite.config.js",
    "start": "node server.js",
    "seed": "node server/seed.js",
    "create-admin": "node server/scripts/createAdmin.js",
    "test": "node --test server/tests/*.test.js",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0",
    "vite": "^7.1.0"
  }
}
