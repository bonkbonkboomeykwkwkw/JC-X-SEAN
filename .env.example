# If .env is missing, copy this file to .env. Keep real credentials and secrets in .env only.
# Paste the Atlas URI from Atlas > Database > Connect > Drivers.
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-name>.mongodb.net/sean-jc-store?retryWrites=true&w=majority
PORT=5000
# Required by the API. Generate a secret with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Add the generated value to your local .env file without replacing other settings.
JWT_SECRET=
# Set these only while running npm run create-admin, then remove them.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
